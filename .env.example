SYNTHGEN_BASE_URL=http://192.168.1.12:11434/v1
SYNTHGEN_API_KEY=ollama
SYNTHGEN_MODEL=qwen3:30b
SYNTHGEN_EMBED_MODEL=paraphrase-multilingual
# Отдельный сервер для эмбеддингов (необязательно; по умолчанию — SYNTHGEN_BASE_URL / SYNTHGEN_API_KEY)
# SYNTHGEN_EMBED_BASE_URL=http://embed-server:8080/v1
# SYNTHGEN_EMBED_API_KEY=
SYNTHGEN_MAX_CONCURRENCY=4
# Для thinking-моделей (qwen3, deepseek-r1): "none" отключает встроенный ризонинг
SYNTHGEN_REASONING_EFFORT=none
